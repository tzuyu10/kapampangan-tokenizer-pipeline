# Tokenizer artifact files are checksum-validated byte-for-byte at load
# time (see src/kapampangan_morphbpe/artifact.py's validate_artifact_files
# and the runtime bridge's _validate_checksums). core.autocrlf is enabled
# globally on this machine; without this override, any checkout-style git
# operation (git stash pop, git checkout, git reset, a fresh clone) rewrites
# these LF-only files as CRLF and silently breaks their recorded SHA-256
# checksums. Treat them as binary so git never touches their line endings.
artifacts/** -text
experiments/**/artifacts/** -text

# Same risk, different source: translation_gold_v1/ and morphology_gold_v1/
# copy external source CSVs into resources/ and record their SHA-256 in a
# provenance-manifest.json computed against the LF on-disk bytes at copy
# time (see AGENT_CONTEXT.md's 2026-08-25 Phase 1 entries). Protect them the
# same way.
experiments/translation_gold_v1/resources/** -text
experiments/morphology_gold_v1/resources/** -text
experiments/parallel_extraction_v1/resources/** -text
experiments/parallel_extraction_v2/resources/** -text
experiments/parallel_extraction_v2/data/** -text

# Phase 3 held-out morphology reference: SHA-256 recorded in
# reports/reference-build-manifest.json and reports/split-manifest.json
# against the LF on-disk bytes.
experiments/tokenizer_selection_v1/data/** -text

# Phase 5 translation split + Colab bundle: SHA-256 recorded in
# experiments/nllb_finetune_v1/reports/split-manifest.json and data/bundle/meta.json.
experiments/nllb_finetune_v1/data/** -text

# Phase 4 NLLB architecture-verification result copied verbatim from Colab;
# SHA-256 recorded in nllb/phase4-provenance-manifest.json.
nllb/phase4-architecture-verification.json -text
