{
  "version": "0.2.0",
  "configurations": [
    { "name": "0. Make toy data",     "type": "debugpy", "request": "launch",
      "program": "scripts/make_toy_data.py", "args": ["--n", "600"],
      "console": "integratedTerminal", "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" } },
    { "name": "1. Prepare data",      "type": "debugpy", "request": "launch",
      "program": "scripts/00_prepare_data.py", "console": "integratedTerminal",
      "cwd": "${workspaceFolder}", "env": { "PYTHONPATH": "${workspaceFolder}/src" } },
    { "name": "2. Validate lexicon",  "type": "debugpy", "request": "launch",
      "program": "scripts/01_validate_lexicon.py", "console": "integratedTerminal",
      "cwd": "${workspaceFolder}", "env": { "PYTHONPATH": "${workspaceFolder}/src" } },
    { "name": "3. Gold template",     "type": "debugpy", "request": "launch",
      "program": "scripts/02_build_gold_template.py", "args": ["--n", "1500"],
      "console": "integratedTerminal", "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" } },
    { "name": "4. Train tokenizer",   "type": "debugpy", "request": "launch",
      "program": "scripts/03_train_tokenizer.py", "console": "integratedTerminal",
      "cwd": "${workspaceFolder}", "env": { "PYTHONPATH": "${workspaceFolder}/src" } },
    { "name": "4b. Train plain BPE",  "type": "debugpy", "request": "launch",
      "program": "scripts/03_train_tokenizer.py", "args": ["--plain-bpe"],
      "console": "integratedTerminal", "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" } },
    { "name": "5. Eval tokenizer",    "type": "debugpy", "request": "launch",
      "program": "scripts/04_eval_tokenizer.py", "console": "integratedTerminal",
      "cwd": "${workspaceFolder}", "env": { "PYTHONPATH": "${workspaceFolder}/src" } },
    { "name": "6. Train NMT (adapted)", "type": "debugpy", "request": "launch",
      "program": "scripts/05_train_nmt.py", "args": ["--arm", "adapted"],
      "console": "integratedTerminal", "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" } },
    { "name": "6b. Train NMT (baseline)", "type": "debugpy", "request": "launch",
      "program": "scripts/05_train_nmt.py", "args": ["--arm", "baseline"],
      "console": "integratedTerminal", "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" } },
    { "name": "7. Translate + eval",  "type": "debugpy", "request": "launch",
      "program": "scripts/06_translate_eval.py",
      "args": ["--arms", "baseline", "adapted"],
      "console": "integratedTerminal", "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" } },
    { "name": "8. Build report",      "type": "debugpy", "request": "launch",
      "program": "scripts/07_report.py", "console": "integratedTerminal",
      "cwd": "${workspaceFolder}", "env": { "PYTHONPATH": "${workspaceFolder}/src" } }
  ]
}
