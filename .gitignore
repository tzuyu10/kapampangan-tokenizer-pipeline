# Latest/WebApp tracks only the app and its project guidance.
# Research files can remain locally without entering this branch's snapshot.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/AI_PROJECT_CONTEXT.md
!/README.md
!/webapp/

# Generated dependencies, environments, caches, and build outputs
.venv*/
node_modules/
dist/
.cache/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.pyc
*.pyd
*.dll
*.so
.DS_Store

# Local configuration and credentials
.env
.env.*
!.env.example

# Superseded/reference-only webapp files and stray lockfiles
/webapp/ARCHITECTURE.md
/webapp/README.md
/webapp/TRANSLATION_SETUP.md
/webapp/frontend/package-lock.json
/webapp/backend/tokenizer/_reference_demo_source.py
